{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES source snapshot manifest (fixtures/g0.5/sources/manifest.json)",
  "type": "object",
  "required": ["capture_id", "retrieved_at", "hash_algorithm", "encoding", "snapshots"],
  "properties": {
    "capture_id": {"type": "string"},
    "retrieved_at": {"$ref": "common/temporal.schema.json#/$defs/iso_date"},
    "hash_algorithm": {"type": "string"},
    "encoding": {"type": "string"},
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis", "snapshot_file", "source_url", "bytes", "sha256"],
        "properties": {
          "hypothesis": {"type": "string"},
          "snapshot_file": {"type": "string"},
          "source_url": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
          "embedded_payload_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
          "source_as_of": {"$ref": "common/temporal.schema.json#/$defs/iso_date_or_datetime_nullable"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
