{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES derived entitlement assertions artifact (fixtures/g0.7/derived-assertions-*.json)",
  "type": "object",
  "required": ["artifact", "assertions", "findings", "identity_index",
               "invalid_identifiers"],
  "properties": {
    "artifact": {
      "type": "object",
      "required": ["artifact_version", "derivation_version",
                   "ruleset_version", "corpus_sha256",
                   "claims_ledger_sha256", "derivation_ruleset_sha256",
                   "source_manifest_sha256", "claims_consumed",
                   "assertions_emitted", "findings_emitted", "assessment"],
      "properties": {
        "artifact_version": {"type": "string"},
        "derivation_version": {"type": "string"},
        "ruleset_version": {"type": "string"},
        "corpus_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "claims_ledger_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "derivation_ruleset_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "claims_consumed": {"type": "integer", "minimum": 0},
        "assertions_emitted": {"type": "integer", "minimum": 0},
        "findings_emitted": {"type": "integer", "minimum": 0},
        "assessment": {"type": "string"}
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertion_id", "register_id", "entity_id",
                     "entity_class", "activity", "jurisdiction",
                     "legal_effect", "entry_mechanism", "territorial_basis",
                     "legal_basis", "effective_from", "effective_to",
                     "scope", "source_assertions", "source_claim_ids",
                     "rule_id", "ruleset_version", "derived_by",
                     "principal_entity_id"],
        "properties": {
          "assertion_id": {"type": "string"},
          "register_id": {"type": "string"},
          "entity_id": {"type": "string"},
          "entity_class": {"type": "string"},
          "activity": {"type": "string"},
          "jurisdiction": {"type": "string"},
          "legal_effect": {
            "type": "string",
            "enum": ["ENTITLED_TO_PROVIDE", "NOT_ENTITLED", "UNKNOWN"]
          },
          "entry_mechanism": {
            "type": "string",
            "enum": ["AUTHORISATION", "NOTIFICATION", "REGISTRATION",
                     "EXEMPTION", "STATUTORY_ENTITLEMENT"]
          },
          "territorial_basis": {
            "type": "string",
            "enum": ["DOMESTIC", "BRANCH", "FREEDOM_TO_PROVIDE_SERVICES", "OTHER"]
          },
          "legal_basis": {"type": "string"},
          "effective_from": {"$ref": "common/temporal.schema.json#/$defs/iso_date"},
          "effective_to": {"$ref": "common/temporal.schema.json#/$defs/iso_date_nullable"},
          "scope": {"type": "string"},
          "source_assertions": {
            "type": "array",
            "items": {"$ref": "common/provenance.schema.json#/$defs/source_assertion"}
          },
          "source_claim_ids": {"type": "array", "items": {"type": "string"}},
          "rule_id": {"type": "string"},
          "ruleset_version": {"type": "string"},
          "derived_by": {
            "oneOf": [
              {
                "type": "object",
                "required": ["rule_id", "ruleset_version"],
                "properties": {
                  "rule_id": {"type": "string"},
                  "ruleset_version": {"type": "string"},
                  "effective_from": {"$ref": "common/temporal.schema.json#/$defs/iso_date"}
                },
                "additionalProperties": false
              },
              {"type": "null"}
            ]
          },
          "principal_entity_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "classification", "corpus_id",
                     "source", "rule_id", "detail"],
        "properties": {
          "finding_id": {"type": "string"},
          "classification": {
            "type": "string",
            "enum": ["REQUIRED_FIELD_MISSING",
                     "REQUIRED_FIELD_UNDERIVABLE",
                     "UNSUPPORTED_ENTITY_CLASS",
                     "UNSUPPORTED_ACTIVITY_MAPPING",
                     "INSUFFICIENT_LEGAL_BASIS",
                     "DERIVED_PRECONDITION_NOT_MET"]
          },
          "corpus_id": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "rule_id": {"type": "string"},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "identity_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "legal_name", "entity_classes",
                     "identifiers", "principal_entity_id"],
        "properties": {
          "entity_id": {"type": "string"},
          "legal_name": {"type": "string"},
          "entity_classes": {"type": "array", "items": {"type": "string"}},
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value", "retrieved_at", "source_url"],
              "properties": {
                "kind": {"type": "string"},
                "value": {"type": "string"},
                "retrieved_at": {"$ref": "common/temporal.schema.json#/$defs/iso_date"},
                "source_url": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "principal_entity_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "invalid_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["corpus_id", "kind", "value", "lei_diagnostic"],
        "properties": {
          "corpus_id": {"type": "string"},
          "kind": {"type": "string"},
          "value": {"type": "string"},
          "lei_diagnostic": {
            "type": "string",
            "enum": ["INVALID_LENGTH", "INVALID_CHARSET",
                     "INVALID_CHECK_DIGITS", "MISSING"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
