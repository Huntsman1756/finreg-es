{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES extraction run artifact (fixtures/g0.5/runs/*.json)",
  "description": "Envelope closed; per-attempt probe internals (parse/identity/semantics/ground_truth) typed structurally, not deep-closed: their detail keys are extractor-version internals, not the public contract.",
  "type": "object",
  "required": ["run", "summary", "attempts", "divergences", "result_sha"],
  "properties": {
    "run": {
      "type": "object",
      "required": ["run_id", "run_version", "executed_at", "corpus_sha",
                   "corpus_manifest_sha256", "ground_truth_sha256",
                   "source_snapshot_sha", "source_baseline_sha",
                   "contracts_sha", "extractor_sha", "extractor_files",
                   "assessment_execution"],
      "properties": {
        "run_id": {"type": "string"},
        "run_version": {"type": "string"},
        "executed_at": {"$ref": "common/temporal.schema.json#/$defs/iso_datetime"},
        "corpus_sha": {"$ref": "common/identifiers.schema.json#/$defs/git_ref"},
        "corpus_manifest_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "ground_truth_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "source_snapshot_sha": {
          "oneOf": [
            {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
            {
              "type": "object",
              "additionalProperties": {"$ref": "common/identifiers.schema.json#/$defs/sha256"}
            }
          ]
        },
        "source_baseline_sha": {"$ref": "common/identifiers.schema.json#/$defs/git_ref"},
        "contracts_sha": {"$ref": "common/identifiers.schema.json#/$defs/git_ref"},
        "extractor_sha": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "extractor_files": {"type": "array", "items": {"type": "object"}},
        "assessment_execution": {"type": "string"},
        "expectation_annotation_rule": {"type": "string"},
        "supersedes_run_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["divergences_by_classification", "divergences_total",
                   "entities_attempted", "ground_truth_entities",
                   "layer_statuses", "source_attempts",
                   "unexpected_divergences"],
      "properties": {
        "divergences_by_classification": {"type": "object", "additionalProperties": {"type": "integer"}},
        "divergences_total": {"type": "integer", "minimum": 0},
        "entities_attempted": {"type": "integer", "minimum": 0},
        "ground_truth_entities": {"type": "object", "additionalProperties": {"type": "integer"}},
        "layer_statuses": {"type": "object"},
        "source_attempts": {"type": "integer", "minimum": 0},
        "unexpected_divergences": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["corpus_id", "source", "snapshot_file", "fetch",
                     "parse", "identity", "semantics", "assessment",
                     "ground_truth", "divergences"],
        "properties": {
          "corpus_id": {"type": "string"},
          "source": {"type": "string"},
          "snapshot_file": {"type": "string"},
          "source_snapshot_sha": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
          "source_record_key": {"type": "object"},
          "legal_name": {"type": "string"},
          "fetch": {
            "type": "object",
            "required": ["status", "mode", "snapshot_file", "bytes", "sha256"],
            "properties": {
              "status": {"type": "string"},
              "mode": {"type": "string"},
              "snapshot_file": {"type": "string"},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"}
            },
            "additionalProperties": false
          },
          "parse": {"type": ["object", "null"]},
          "identity": {"type": ["object", "null"]},
          "semantics": {"type": ["object", "null"]},
          "assessment": {"type": "object"},
          "pre_registered_contract_risks": {"type": "array"},
          "ground_truth": {"type": "object"},
          "divergences": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["corpus_id", "source", "layer", "classification",
                     "reason", "expected_in_ground_truth"],
        "properties": {
          "corpus_id": {"type": "string"},
          "source": {"type": "string"},
          "snapshot_file": {"type": ["string", "null"]},
          "layer": {"type": "string"},
          "classification": {"type": "string"},
          "reason": {"type": "string"},
          "lei_diagnostic": {"type": ["string", "null"]},
          "expected_in_ground_truth": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "result_sha": {"$ref": "common/identifiers.schema.json#/$defs/sha256"}
  },
  "additionalProperties": false
}
