{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES preregistered ground truth (fixtures/g0.5/corpus/ground-truth.json)",
  "type": "object",
  "required": ["ground_truth_id", "as_of", "written_before_extractor_run",
               "basis", "global_rules", "source_expectations",
               "entity_expectations"],
  "properties": {
    "ground_truth_id": {"type": "string"},
    "as_of": {"$ref": "common/temporal.schema.json#/$defs/iso_date"},
    "written_before_extractor_run": {"type": "boolean", "const": true},
    "basis": {"type": "string"},
    "global_rules": {"type": "array", "items": {"type": "string"}},
    "source_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "snapshot_file", "expected_presence",
                     "expected_identity", "expected_aggregate_assessment",
                     "negative_inference"],
        "properties": {
          "source": {"type": "string"},
          "snapshot_file": {"type": "string"},
          "expected_presence": {"type": "string"},
          "expected_identity": {"type": "array", "items": {"type": "string"}},
          "expected_home_member_state": {"type": ["string", "null"]},
          "expected_competent_authority": {"type": ["string", "null"]},
          "expected_aggregate_assessment": {"type": "string"},
          "expected_contract_risks": {"type": "array", "items": {"type": "string"}},
          "negative_inference": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "entity_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["corpus_id", "expected_source_presence",
                     "expected_facts", "expected_contract_risks"],
        "properties": {
          "corpus_id": {"type": "string"},
          "expected_source_presence": {"type": "array", "items": {"type": "string"}},
          "expected_facts": {"type": "array", "items": {"type": "string"}},
          "expected_contract_risks": {"type": "array", "items": {"type": "string"}},
          "identity_join": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
