{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES common temporal primitives",
  "description": "Structural shapes only. Temporal semantics (freshness_at, staleness, SUSPECT rule) live in finreg_es/temporal.py, not here.",
  "$defs": {
    "iso_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "iso_date_nullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "iso_datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "iso_date_or_datetime_nullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2}))?$"
    },
    "source_date_reliability": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "SUSPECT",
        "UNAVAILABLE"
      ]
    }
  }
}