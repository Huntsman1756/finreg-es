{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES common provenance primitives",
  "$defs": {
    "source_assertion": {
      "type": "object",
      "required": [
        "authority",
        "register_id",
        "source_url",
        "retrieved_at",
        "source_as_of",
        "source_date_reliability",
        "raw_value",
        "raw_snapshot_sha256",
        "extractor_version",
        "observed_current"
      ],
      "properties": {
        "authority": {
          "type": "string"
        },
        "register_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "retrieved_at": {
          "$ref": "temporal.schema.json#/$defs/iso_date"
        },
        "source_as_of": {
          "$ref": "temporal.schema.json#/$defs/iso_date_nullable"
        },
        "source_date_reliability": {
          "$ref": "temporal.schema.json#/$defs/source_date_reliability"
        },
        "raw_value": {},
        "raw_snapshot_sha256": {
          "$ref": "identifiers.schema.json#/$defs/sha256"
        },
        "extractor_version": {
          "type": "string"
        },
        "observed_current": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}