{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES claim provenance ledger (fixtures/g0.6/claim-provenance-*.json)",
  "description": "Envelope and claim envelope closed; record_key and raw/normalized values stay free-form because they carry authority-controlled content.",
  "type": "object",
  "required": ["ledger", "claims"],
  "properties": {
    "ledger": {
      "type": "object",
      "required": ["ledger_id", "ledger_version", "run_id",
                   "run_result_sha", "claims_total", "untraced_fields"],
      "properties": {
        "ledger_id": {"type": "string"},
        "ledger_version": {"type": "string"},
        "run_id": {"type": "string"},
        "run_result_sha": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
        "claims_total": {"type": "integer", "minimum": 0},
        "untraced_fields": {"type": "array"}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id", "corpus_id", "source", "register_id", "authority",
          "field", "raw_value", "normalized_value", "record_key",
          "snapshot_file", "snapshot_sha256", "raw_record_sha256",
          "retrieved_at", "source_as_of", "source_date_reliability",
          "extracted_at", "extractor_version", "parser",
          "rule", "rule_version", "semantic_derivation",
          "assertion_candidate"
        ],
        "properties": {
          "claim_id": {"type": "string"},
          "corpus_id": {"type": "string"},
          "source": {"type": "string"},
          "register_id": {"type": "string"},
          "authority": {"type": "string"},
          "field": {"type": "string"},
          "raw_value": {},
          "normalized_value": {},
          "record_key": {"type": "object"},
          "snapshot_file": {"type": "string"},
          "snapshot_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
          "raw_record_sha256": {"$ref": "common/identifiers.schema.json#/$defs/sha256"},
          "retrieved_at": {"$ref": "common/temporal.schema.json#/$defs/iso_date"},
          "source_as_of": {"$ref": "common/temporal.schema.json#/$defs/iso_date_or_datetime_nullable"},
          "source_date_reliability": {"$ref": "common/temporal.schema.json#/$defs/source_date_reliability"},
          "extracted_at": {"$ref": "common/temporal.schema.json#/$defs/iso_datetime"},
          "extractor_version": {"type": "string"},
          "parser": {"type": "string"},
          "rule": {"type": "string"},
          "rule_version": {"type": "string"},
          "semantic_derivation": {
            "type": "object",
            "required": ["status", "reason"],
            "properties": {
              "status": {"type": "string"},
              "reason": {"type": "string"}
            },
            "additionalProperties": false
          },
          "assertion_candidate": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
