{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES frozen entity corpus (fixtures/g0.5/corpus/entities.json)",
  "type": "object",
  "required": ["corpus_id", "as_of", "entity_count", "selection_rule", "entities"],
  "properties": {
    "corpus_id": {"type": "string"},
    "as_of": {"$ref": "common/temporal.schema.json#/$defs/iso_date"},
    "entity_count": {"type": "integer", "minimum": 1},
    "selection_rule": {"type": "string"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["corpus_id", "legal_name", "source_records", "inclusion_reason"],
        "properties": {
          "corpus_id": {"$ref": "common/identifiers.schema.json#/$defs/corpus_id"},
          "legal_name": {"type": "string"},
          "source_records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "snapshot_file", "record_key"],
              "properties": {
                "source": {"type": "string"},
                "snapshot_file": {"type": "string"},
                "record_key": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "inclusion_reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
