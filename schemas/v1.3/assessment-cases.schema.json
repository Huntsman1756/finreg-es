    },
    "reported_facts_policy": {
     "type": "string"
    },
    "semantics_boundary": {
     "type": "string"
    },
    "semantics_version": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "version": {
     "type": "string"
    }
   },
   "required": [
    "version",
    "gate",
    "unit",
    "entity_id_semantics",
    "preregistered_before_assessment",
    "match_definition",
    "categories_not_representable_in_frozen_corpus"
   ],
   "type": "object"
  }
 },
 "required": [
  "cases_meta",
  "cases"
 ],
