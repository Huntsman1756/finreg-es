{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "description": "v1.3: adds optional territorial_basis to scope the query to a single route (G1-E, E5 route-aware aggregation). Compatible extension of v1.2.",
 "properties": {
  "cases": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "activity": {
      "type": "string"
     },
     "as_of": {
      "$ref": "v1/common/temporal.schema.json#/$defs/iso_date"
     },
     "case_id": {
      "pattern": "^G1[A-Z]-[0-9]{2,3}$",
      "type": "string"
     },
     "entity_id": {
      "type": "string"
     },
     "expected_assessment": {
      "enum": [
       "CONFIRMED_ENTITLED",
       "NO_ENTITLEMENT_EVIDENCED",
       "CONFIRMED_NOT_ENTITLED",
       "INDETERMINATE"
      ],
      "type": "string"
     },
     "expected_basis": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "expected_entry_mechanism": {
      "enum": [
       "AUTHORISATION",
       "NOTIFICATION",
       "REGISTRATION",
       "EXEMPTION",
       "STATUTORY_ENTITLEMENT",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "expected_legal_basis": {
      "description": "Base legal completa esperada: mecanismo de base + activacion territorial (ej. MiCA 63 + 65)",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "expected_reason": {
      "type": "string"
     },
     "expected_territorial_basis": {
      "description": "Bases territoriales esperadas en las aserciones emitidas; array vacio = ninguna asercion territorial esperada",
      "items": {
       "enum": [
        "DOMESTIC",
        "BRANCH",
        "FREEDOM_TO_PROVIDE_SERVICES"
       ],
       "type": "string"
      },
      "type": "array",
      "uniqueItems": true
     },
     "jurisdiction": {
      "type": "string"
     },
     "known_limitations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "primary_evidence": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "probes": {
      "type": "string"
     },
     "territorial_basis": {
      "enum": [
       "DOMESTIC",
       "BRANCH",
       "FREEDOM_TO_PROVIDE_SERVICES",
       "OTHER"
      ],
      "type": "string"
     }
    },
    "required": [
     "case_id",
     "entity_id",
     "activity",
     "jurisdiction",
     "as_of",
     "expected_assessment",
     "expected_reason",
     "expected_basis",
     "primary_evidence",
     "known_limitations",
     "probes"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "cases_meta": {
   "additionalProperties": false,
   "properties": {
    "categories_not_representable_in_frozen_corpus": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "category": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
