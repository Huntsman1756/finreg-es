{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "FinReg-ES preregistered assessment cases v1.2 (fixtures/g1/assessment-cases-g1-d.json)",
 "description": "v1.2: adds optional expected_territorial_basis and expected_legal_basis for G1-D territorial cases (expected_entry_mechanism survives territorialization). Compatible extension of v1.1.",
 "type": "object",
 "required": [
  "cases_meta",
  "cases"
 ],
 "properties": {
  "cases_meta": {
   "type": "object",
   "required": [
    "version",
    "gate",
    "unit",
    "entity_id_semantics",
    "preregistered_before_assessment",
    "match_definition",
    "categories_not_representable_in_frozen_corpus"
   ],
   "properties": {
    "version": {
     "type": "string"
    },
    "gate": {
     "type": "string"
    },
    "semantics_version": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "entity_id_semantics": {
     "type": "string"
    },
    "semantics_boundary": {
     "type": "string"
    },
    "reported_facts_policy": {
     "type": "string"
    },
    "preregistered_before_assessment": {
     "type": "string"
    },
    "match_definition": {
     "type": "string"
    },
    "categories_not_representable_in_frozen_corpus": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "category",
       "reason"
      ],
      "properties": {
       "category": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  },
  "cases": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "case_id",
     "entity_id",
     "activity",
     "jurisdiction",
     "as_of",
     "expected_assessment",
     "expected_reason",
     "expected_basis",
     "primary_evidence",
     "known_limitations",
     "probes"
    ],
    "properties": {
     "case_id": {
      "type": "string",
      "pattern": "^G1[A-Z]-[0-9]{2,3}$"
     },
     "entity_id": {
      "type": "string"
     },
     "activity": {
      "type": "string"
     },
     "jurisdiction": {
      "type": "string"
     },
     "as_of": {
      "$ref": "v1/common/temporal.schema.json#/$defs/iso_date"
     },
     "expected_assessment": {
      "type": "string",
      "enum": [
       "CONFIRMED_ENTITLED",
       "NO_ENTITLEMENT_EVIDENCED",
       "CONFIRMED_NOT_ENTITLED",
       "INDETERMINATE"
      ]
     },
     "expected_reason": {
      "type": "string"
     },
     "expected_entry_mechanism": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "AUTHORISATION",
       "NOTIFICATION",
       "REGISTRATION",
       "EXEMPTION",
       "STATUTORY_ENTITLEMENT",
       null
      ]
     },
     "expected_basis": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "primary_evidence": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "known_limitations": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "probes": {
      "type": "string"
     },
     "expected_territorial_basis": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "DOMESTIC",
        "BRANCH",
        "FREEDOM_TO_PROVIDE_SERVICES"
       ]
      },
      "uniqueItems": true,
      "description": "Bases territoriales esperadas en las aserciones emitidas; array vacio = ninguna asercion territorial esperada"
     },
     "expected_legal_basis": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Base legal completa esperada: mecanismo de base + activacion territorial (ej. MiCA 63 + 65)"
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}