{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "regulatory-record-entity/v1",
 "description": "Public read model for a Regulatory Record ES entity ficha. Emitted by tools/g4/build_projection.py from frozen evidence only.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema", "id", "identity", "status", "registrations", "permissions",
  "locations", "organisation", "regulatory_record", "timeline",
  "sources", "coverage", "freshness"
 ],
 "properties": {
  "schema": {"const": "regulatory-record-entity/v1"},
  "id": {"type": "string", "pattern": "^(esi|sgiic|ede|ins)-[a-z0-9]+$"},
  "identity": {
   "type": "object",
   "additionalProperties": false,
   "required": ["legal_name", "aliases", "identifiers", "resolution"],
   "properties": {
    "legal_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "identifiers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
       "scheme": {"type": "string"},
       "value": {"type": "string"},
       "country": {"type": "string"}
      }
     }
    },
    "resolution": {"enum": ["EXACT", "CONFLICT", "UNRESOLVED", "CANDIDATE"]}
   }
  },
  "status": {
   "type": "object",
   "additionalProperties": false,
   "required": ["value", "as_of", "basis"],
   "properties": {
    "value": {"enum": ["REGISTERED", "DEREGISTERED", "SUSPENDED", "UNKNOWN"]},
    "as_of": {"type": "string"},
    "basis": {"type": "string"},
    "source_value": {"type": "string"}
   }
  },
  "registrations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["regulator", "register", "basis"],
    "properties": {
     "regulator": {"type": "string"},
     "register": {"type": "string"},
     "number": {"type": ["string", "null"]},
     "register_type": {"type": ["string", "null"]},
     "date": {"type": ["string", "null"]},
     "cancelled": {"type": ["string", "null"]},
     "state": {"type": ["string", "null"]},
     "basis": {"type": "string"},
     "conflict_with": {"type": ["string", "null"]}
    }
   }
  },
  "permissions": {
   "oneOf": [
    {"const": "UNKNOWN"},
    {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["service", "basis"],
      "properties": {
       "service": {"type": "string"},
       "kind": {"type": "string"},
       "code": {"type": "string"},
       "norm": {"type": "string"},
       "instruments": {"type": "array", "items": {"type": "string"}},
       "clients": {"type": "array", "items": {"type": "string"}},
       "since": {"type": ["string", "null"]},
       "basis": {"type": "string"}
      }
     }
    }
   ]
  },
  "locations": {
   "type": "object",
   "required": ["domicile", "branches", "agents", "passporting"],
   "properties": {
    "domicile": {"type": "string"},
    "branches": {"type": "array"},
    "agents": {"type": "array"},
    "passporting": {}
   }
  },
  "organisation": {"type": "object"},
  "regulatory_record": {
   "type": "object",
   "additionalProperties": false,
   "required": ["sanctions", "appeals", "direct_warnings", "impersonations", "candidates"],
   "properties": {
    "sanctions": {"type": "array"},
    "appeals": {"type": "array"},
    "direct_warnings": {"type": "array"},
    "impersonations": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["notice_id", "warned_name", "relation", "legitimate_entity", "evidence"],
      "properties": {
       "relation": {"enum": ["IMPERSONATES", "CLONE_OF"]},
       "legitimate_entity": {
        "type": "object",
        "required": ["registry_number", "relation"],
        "properties": {
         "registry_number": {"type": "string"},
         "relation": {"const": "MENTIONED_AS_LEGITIMATE_ENTITY"}
        }
       }
      }
     }
    },
    "candidates": {"type": "array"}
   }
  },
  "timeline": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["date_or_interval", "kind", "summary", "evidence"],
    "properties": {
     "date_or_interval": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}]},
     "kind": {"enum": ["EXPLICIT_OFFICIAL_EVENT", "OFFICIAL_AS_OF_STATE", "OFFICIAL_DOCUMENT_DERIVATION", "OBSERVED_CHANGE"]},
     "summary": {"type": "string"},
     "evidence": {"type": "string"}
    }
   }
  },
  "sources": {"type": "array", "items": {"type": "object", "required": ["source"], "properties": {"source": {"type": "string"}}}},
  "coverage": {
   "type": "object",
   "required": ["identity", "registration", "permission", "history", "sanction", "warning", "branch", "passport", "provenance"],
   "properties": {
    "history": {"enum": ["COVERED", "NO HISTORICAL EVIDENCE", "NO_EVIDENCE"]}
   }
  },
  "freshness": {
   "type": "object",
   "required": ["last_successful_refresh", "source_status"],
   "properties": {
    "last_successful_refresh": {"type": "string"},
    "source_status": {"type": "string"}
   }
  }
 }
}
