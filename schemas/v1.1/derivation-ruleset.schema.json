{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES derivation ruleset v1.1 (fixtures/g1/derivation-rules.json)",
  "description": "Structural contract only. v1.1 adds G1-A constructs: emit_status_fact (reported facts, no legal effect), evidence_basis/reported_status/_from field references in emit blocks, and the EBA_ENT_AUT_LAST_AUTH effective derivation. Rule semantics are enforced by finreg_es/derivation.py and regulatory tests, not here.",
  "type": "object",
  "required": ["ruleset"],
  "properties": {
    "ruleset": {
      "type": "object",
      "required": ["ruleset_id", "ruleset_version", "gate", "purpose",
                   "frozen_inputs", "policy", "failure_taxonomy",
                   "effective_derivations", "rules", "derived_rules"],
      "properties": {
        "ruleset_id": {"type": "string"},
        "ruleset_version": {"type": "string"},
        "gate": {"type": "string"},
        "purpose": {"type": "string"},
        "frozen_inputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "policy": {"type": "object", "additionalProperties": {"type": "string"}},
        "failure_taxonomy": {"type": "array", "items": {"type": "string"}},
        "effective_derivations": {"type": "object", "additionalProperties": {"type": "string"}},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule"}
        },
        "derived_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/derived_rule"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field_derivation": {
      "type": "object",
      "required": ["derivation"],
      "properties": {
        "derivation": {
          "type": "string",
          "enum": ["CONSTANT_NULL", "EVIDENCE_AS_OF", "FIELD_DDMMYYYY",
                   "FIELD_DDMMYYYY_OR_NULL", "EBA_ENT_AUT_LAST_AUTH"]
        },
        "field": {"type": "string"}
      },
      "additionalProperties": false
    },
    "field_ref": {
      "type": "object",
      "required": ["field"],
      "properties": {"field": {"type": "string"}},
      "additionalProperties": false
    },
    "emit_block": {
      "type": "object",
      "required": ["jurisdiction", "territorial_basis", "legal_effect",
                   "entry_mechanism", "legal_basis", "scope",
                   "effective_from", "effective_to"],
      "properties": {
        "entity_class": {"type": "string"},
        "entity_class_from": {
          "type": "object",
          "required": ["field", "map"],
          "properties": {
            "field": {"type": "string"},
            "map": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "activity": {"type": "string"},
        "activity_from": {
          "type": "object",
          "required": ["field", "map"],
          "properties": {
            "field": {"type": "string"},
            "map": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "jurisdiction": {"type": "string"},
        "territorial_basis": {"type": "string"},
        "legal_effect": {"type": "string"},
        "entry_mechanism": {"type": "string"},
        "legal_basis": {"type": "string"},
        "scope": {"type": "string"},
        "effective_from": {"$ref": "#/$defs/field_derivation"},
        "effective_to": {"$ref": "#/$defs/field_derivation"},
        "evidence_basis": {
          "type": "string",
          "enum": ["NCA_REPORTED_VIA_EBA", "NCA_PRIMARY", "STATISTICAL"]
        },
        "reported_status": {
          "type": "string",
          "enum": ["ACTIVE", "WITHDRAWN", "UNKNOWN"]
        },
        "reported_status_from": {"$ref": "#/$defs/field_ref"},
        "status_intervals_from": {"$ref": "#/$defs/field_ref"}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "required_source_contract", "match",
                   "required_fields", "coverage_preconditions",
                   "failure_behavior", "rationale", "known_limitations"],
      "properties": {
        "rule_id": {"type": "string"},
        "required_source_contract": {"type": "string"},
        "match": {
          "type": "object",
          "required": ["source", "conditions"],
          "properties": {
            "source": {"type": "string"},
            "conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "op"],
                "properties": {
                  "field": {"type": "string"},
                  "op": {"type": "string"},
                  "value": {}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "coverage_preconditions": {"type": "array", "items": {"type": "string"}},
        "emit": {"oneOf": [{"$ref": "#/$defs/emit_block"}, {"type": "null"}]},
        "emit_per": {
          "type": "object",
          "required": ["iterate", "emit"],
          "properties": {
            "iterate": {
              "type": "object",
              "required": ["field", "mode"],
              "properties": {
                "field": {"type": "string"},
                "mode": {"type": "string", "enum": ["SPLIT", "DICT_KEYS"]},
                "separator": {"type": "string"},
                "exclude_field_value": {"type": "string"},
                "exclude_values": {"type": "array"}
              },
              "additionalProperties": false
            },
            "emit": {"$ref": "#/$defs/emit_block"}
          },
          "additionalProperties": false
        },
        "emit_status_fact": {
          "type": "object",
          "properties": {
            "reported_status": {
              "type": "string",
              "enum": ["ACTIVE", "WITHDRAWN", "UNKNOWN"]
            },
            "reported_status_from": {"$ref": "#/$defs/field_ref"},
            "detail": {"type": "string"}
          },
          "additionalProperties": false
        },
        "finding": {
          "type": "object",
          "required": ["classification", "detail"],
          "properties": {
            "classification": {"type": "string"},
            "detail": {"type": "string"}
          },
          "additionalProperties": false
        },
        "failure_behavior": {"type": "string"},
        "rationale": {"type": "string"},
        "known_limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "derived_rule": {
      "type": "object",
      "required": ["rule_id", "ruleset_version", "type", "base", "emit",
                   "untriggered_finding"],
      "properties": {
        "rule_id": {"type": "string"},
        "ruleset_version": {"type": "string"},
        "type": {"type": "string"},
        "base": {"type": "object"},
        "emit": {"type": "object"},
        "untriggered_finding": {
          "type": "object",
          "required": ["classification", "detail"],
          "properties": {
            "classification": {"type": "string"},
            "detail": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
