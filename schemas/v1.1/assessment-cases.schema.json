{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinReg-ES preregistered assessment cases v1.1 (fixtures/g1/assessment-cases.json)",
  "description": "v1.1: expected_assessment uses ASSESSMENT_SEMANTICS_V2 values; adds optional expected_entry_mechanism and semantics_version in cases_meta. V1 cases remain valid under schemas/v1.",
  "type": "object",
  "required": ["cases_meta", "cases"],
  "properties": {
    "cases_meta": {
      "type": "object",
      "required": ["version", "gate", "unit", "entity_id_semantics",
                   "preregistered_before_assessment", "match_definition",
                   "categories_not_representable_in_frozen_corpus"],
      "properties": {
        "version": {"type": "string"},
        "gate": {"type": "string"},
        "semantics_version": {"type": "string"},
        "unit": {"type": "string"},
        "entity_id_semantics": {"type": "string"},
        "semantics_boundary": {"type": "string"},
        "reported_facts_policy": {"type": "string"},
        "preregistered_before_assessment": {"type": "string"},
        "match_definition": {"type": "string"},
        "categories_not_representable_in_frozen_corpus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "reason"],
            "properties": {
              "category": {"type": "string"},
              "reason": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "entity_id", "activity", "jurisdiction",
                     "as_of", "expected_assessment", "expected_reason",
                     "expected_basis", "primary_evidence",
                     "known_limitations", "probes"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^G1A-[0-9]{3}$"},
          "entity_id": {"type": "string"},
          "activity": {"type": "string"},
          "jurisdiction": {"type": "string"},
          "as_of": {"$ref": "v1/common/temporal.schema.json#/$defs/iso_date"},
          "expected_assessment": {
            "type": "string",
            "enum": ["CONFIRMED_ENTITLED", "NO_ENTITLEMENT_EVIDENCED",
                     "CONFIRMED_NOT_ENTITLED", "INDETERMINATE"]
          },
          "expected_reason": {"type": "string"},
          "expected_entry_mechanism": {
            "type": ["string", "null"],
            "enum": ["AUTHORISATION", "NOTIFICATION", "REGISTRATION",
                     "EXEMPTION", "STATUTORY_ENTITLEMENT", null]
          },
          "expected_basis": {"type": "array", "items": {"type": "string"}},
          "primary_evidence": {"type": "array", "items": {"type": "string"}},
          "known_limitations": {"type": "array", "items": {"type": "string"}},
          "probes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
