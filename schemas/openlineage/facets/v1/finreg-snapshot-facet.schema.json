{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finreg-es:schema:openlineage:v1:finreg-snapshot",
  "title": "FinReg-ES OpenLineage custom dataset facet: source snapshot",
  "description": "Dataset facet for authority source snapshots consumed by a FinReg extraction run. Carries capture metadata only; regulatory semantics stay in FinReg artifacts.",
  "type": "object",
  "required": ["_producer", "_schemaURL", "snapshot_file", "sha256",
               "source_url", "retrieved_at", "source_as_of"],
  "properties": {
    "_producer": {"type": "string"},
    "_schemaURL": {"type": "string"},
    "snapshot_file": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "embedded_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_url": {"type": "string"},
    "bytes": {"type": "integer", "minimum": 0},
    "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_as_of": {"type": ["string", "null"]},
    "hypothesis": {"type": "string"},
    "source": {"type": "string"},
    "register_id": {"type": "string"},
    "authority": {"type": "string"}
  },
  "additionalProperties": false
}
