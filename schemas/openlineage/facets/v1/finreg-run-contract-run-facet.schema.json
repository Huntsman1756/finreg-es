{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finreg-es:schema:openlineage:v1:finreg-run-contract",
  "title": "FinReg-ES OpenLineage custom run facet: FinregRunContractRunFacet",
  "description": "Run facet for FinReg runs with recorded execution metadata: the run's recorded input contract verbatim, code identity, output pin and supersession edge. Only for RunEvents — a recorded executed_at must exist.",
  "type": "object",
  "required": ["_producer", "_schemaURL", "finreg_run_id",
               "finreg_run_version", "input_contract", "executed_at"],
  "properties": {
    "_producer": {"type": "string"},
    "_schemaURL": {"type": "string"},
    "finreg_run_id": {"type": "string"},
    "finreg_run_version": {"type": "string"},
    "gate": {"type": "string"},
    "executed_at": {"type": "string"},
    "input_contract": {
      "$ref": "urn:finreg-es:schema:openlineage:v1:finreg-contract-common#/$defs/input_contract"
    },
    "code": {
      "$ref": "urn:finreg-es:schema:openlineage:v1:finreg-contract-common#/$defs/code"
    },
    "output_sha256": {
      "$ref": "urn:finreg-es:schema:openlineage:v1:finreg-contract-common#/$defs/sha256"
    },
    "supersedes_run_id": {"type": "string"}
  },
  "additionalProperties": false
}
