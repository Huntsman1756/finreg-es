---
import Base from "../layouts/Base.astro";
import { manifest } from "../lib/data";
---
<Base title="Datos" crumbs={[{ href: "/datos/", label: "Datos" }]}>
  <h1>Datos</h1>
  <p>
    La proyección pública completa es descargable en JSON. Schema:
    <code>{manifest.schema}</code> · entidad: <code>regulatory-record-entity/v1</code> ·
    bundle SHA-256: <code>{manifest.bundle_sha256}</code>
  </p>
  <table>
    <tbody>
      <tr><td><a href="/data/manifest.json">manifest.json</a></td><td class="muted small">versión, conteos, bundle hash, inputs</td></tr>
      <tr><td><a href="/data/entities.json">entities.json</a></td><td class="muted small">índice de entidades</td></tr>
      <tr><td><a href="/data/changes.json">changes.json</a></td><td class="muted small">feed de cambios clasificados</td></tr>
      <tr><td><a href="/data/sources.json">sources.json</a></td><td class="muted small">fuentes y freshness</td></tr>
      <tr><td><a href="/data/entities/">entities/</a></td><td class="muted small">una ficha JSON por entidad</td></tr>
    </tbody>
  </table>
  <p class="small muted">
    Los artefactos se regeneran de forma determinista: mismas evidencias
    congeladas → mismos bytes. El schema público está versionado en
    <code>schemas/public/</code> del repositorio.
  </p>
</Base>
