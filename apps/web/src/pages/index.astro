---
import Base from "../layouts/Base.astro";
import { index, manifest } from "../lib/data";
---
<Base title="Registro regulatorio verificable de entidades financieras en España"
      description="Qué entidad es, bajo qué reguladores figura, qué está autorizada a hacer, dónde puede operar y qué hechos regulatorios oficiales constan — con evidencia verificable.">
  <h1>Regulatory Record ES</h1>
  <p>
    Registro regulatorio público y provisional construido sobre fuentes
    oficiales congeladas y verificables. Para cada entidad: qué es, bajo qué
    reguladores figura, qué está autorizada a hacer, dónde puede operar, cómo
    ha cambiado y qué hechos regulatorios oficiales constan sobre ella.
  </p>
  <p class="muted">
    Este registro <strong>no</strong> emite valoraciones: no hay ratings,
    scores, rankings ni recomendaciones. Donde la evidencia no alcanza, se
    declara explícitamente.
  </p>

  <form action="/buscar/" method="get" role="search">
    <label for="q">Buscar entidad por nombre, NIF, LEI o nº de registro</label><br />
    <input type="search" id="q" name="q" placeholder="p. ej. Abante, A87515540, 959800…" />
  </form>

  <h2>Entidades registradas ({index.length})</h2>
  <table>
    <thead><tr><th>Entidad</th><th>Vertical</th><th>Estado</th></tr></thead>
    <tbody>
      {index.map((e: any) => (
        <tr>
          <td><a href={`/entidad/${e.id}/`}>{e.name}</a></td>
          <td class="muted small">{e.vertical}</td>
          <td class={e.status === "REGISTERED" ? "status ok" : "status off"}>{e.status}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="src">
    Datos: {manifest.schema} · {manifest.entity_count} entidades · bundle
    <code>{manifest.bundle_sha256.slice(0, 16)}…</code>
    — <a href="/datos/">descargas y schema</a>
  </p>
</Base>
